# VoiceEval backend — example environment.
# Copy to .env and fill in real values. Never commit secrets.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://voiceeval:voiceeval@localhost:5432/voiceeval

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---

JWT_SECRET=change-me-in-production
JWT_ISSUER=voiceeval
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Object storage ---
OBJECT_STORAGE_MODE=local
LOCAL_OBJECT_STORAGE_PATH=./data/object-store

# --- S3 (used when OBJECT_STORAGE_MODE=s3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voiceeval
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Providers ---
OPENAI_API_KEY=
SARVAM_API_KEY=
# OpenRouter (LLM stage for the pipecat caller).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Pipecat caller (naive websocket caller runtime) ---
# Max concurrent caller agents the spawning layer keeps live.
PIPECAT_CALLER_MAX_CONCURRENT=5
# Target-link transports this runtime dials (comma-separated).
PIPECAT_CALLER_TARGET_TRANSPORTS=websocket,fake
# Websocket wire protocol: "protobuf" (native Pipecat agents) or "voiceeval"
# (the raw-PCM/JSON fake target). A target may also declare it in its
# endpoint_config as "protocol".
PIPECAT_CALLER_PROTOCOL=protobuf
PIPECAT_CALLER_POLL_INTERVAL_S=2
PIPECAT_CALLER_CONNECT_TIMEOUT_S=15
PIPECAT_CALLER_UPLOAD_TIMEOUT_S=60
PIPECAT_CALLER_WALL_CLOCK_TIMEOUT_S=180
# Pipeline (Sarvam STT/TTS + OpenRouter LLM).
PIPECAT_CALLER_STT_MODEL=saaras:v4
PIPECAT_CALLER_TTS_MODEL=bulbul:v3
PIPECAT_CALLER_TTS_VOICE=shubh
PIPECAT_CALLER_LANGUAGE=hi-IN
PIPECAT_CALLER_IN_SAMPLE_RATE=16000
PIPECAT_CALLER_OUT_SAMPLE_RATE=16000
PIPECAT_CALLER_GREET_FIRST=true
